# Copy this file to .env and fill in real values.  .env is git-ignored.

# Snowflake account identifier: <orgname>-<accountname>
# (Snowsight -> bottom-left profile -> Account -> "View account details")
SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_USER=SETTLE_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=keys/rsa_key.p8
SNOWFLAKE_WAREHOUSE=SETTLE_WH
SNOWFLAKE_DATABASE=SETTLEMENT_DB
SNOWFLAKE_PIPELINE_ROLE=PIPELINE_ROLE
SNOWFLAKE_API_ROLE=API_ROLE

# Key the dashboard / API callers must send in the X-API-Key header.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me-to-a-long-random-string

# Business rule settings
LATE_EVENT_THRESHOLD_MIN=5
